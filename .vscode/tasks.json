{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Library System",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-O2",
        "-Isrc",
        "src/main.cpp",
        "src/book.cpp",
        "src/chainedhashtable.cpp",
        "src/libraryapp.cpp",
        "-o",
        "library_system.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}